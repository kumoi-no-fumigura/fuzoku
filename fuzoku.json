 "blocks": [
  {
   "id": "fuzoku-000001",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "（見出し無し）",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "末に出づ古今集東歌の最求女子歌アハレ。千早振賀茂の御社の。姫小松。アハレ姫小松。萬代經とも。色はかは。アハレ色はかはらじ。いはたしたー地名なるべし袖を垂れて。あな安らけ」。千鳥故に。濱に出て。遊ぶ千鳥故に。文も無き小松がうれに。網な張りそ。網な張りそ。いはたしたエ。笠忘れたりや。いはたしたエ。殿原もしるくもがなや。笠奉り置かむ。笠奉り置かむや」。知らざらむ。あせか其殿原。知らざらむ。いはたなるや。たへのとのは。近き隣を。近き隣を」。以上六段をひおほひれ、枝からぬが如し妻をいふ於保比禮おほひれや。をひれの山は。よりてこそ。よりてこそ。山はよらなれや。とほめはれと。",
   "yomi": "",
   "sachu": "千早振-この歌あせか-何故かうれ-末れ-大比枝小比よらなれや-寄とほめ-吾が遠",
   "jo": false,
   "pages": [
    88
   ],
   "no": 1,
   "poems": []
  },
  {
   "id": "fuzoku-000002",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "風俗",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "こゆるすりきぬを「磯菜摘む」に作る",
   "yomi": "",
   "sachu": "-眞淵云、こゆすぐりきぬの誤來ぬと也也、此所より過戀すくせ-戀のやりすごしにくき也此歌古今集東歌に見え、「菜摘む」",
   "jo": false,
   "pages": [
    88
   ],
   "no": 2,
   "poems": []
  },
  {
   "id": "fuzoku-000003",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "小筑波",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "小筑波を。こゆるすりきぬ。かへりきてャ。たが戀すくせ。をつくばを。こゆるすきぬ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    88
   ],
   "no": 3,
   "poems": []
  },
  {
   "id": "fuzoku-000004",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "小由流支",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "小淘綾の。磯立ち馴らし。磯ならし。菜摘む。童女ぬらすな。ぬらすな沖に折れ。をれ波ヤ。濡ろ〓〓も。君が食すべき。めすべき。菜をし摘み。摘みて。ハヤ。",
   "yomi": "",
   "sachu": "なみ",
   "jo": false,
   "pages": [
    88
   ],
   "no": 4,
   "poems": []
  },
  {
   "id": "fuzoku-000005",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "埀玉",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "玉だれの。小瓶を。中にすゑて。主はもや。肴覓ぎに。肴とりに。こゆるぎの。磯の若和布。刈りあげに。加閉、貌似鴨而小背上有文」まねー眞に也ものをによする-己を似寄する、己をそれに比する意なるべしゆ此歌古今集に見鴛鴦鴛鷸鴨さへ來ゐる。原の池のャ。玉藻はまねな刈りそャ。生ひも續ぐがにや。おひもつぐがに。",
   "yomi": "",
   "sachu": "鷄-和名抄多",
   "jo": false,
   "pages": [
    88,
    89
   ],
   "no": 5,
   "poems": []
  },
  {
   "id": "fuzoku-000006",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "之太乃浦",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "しだの浦を。朝こぐ小舟。さし寄せろ。我さへ乘りてナ。しだよ。しだの浦みむヤ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 6,
   "poems": []
  },
  {
   "id": "fuzoku-000007",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "君乎置天",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "きみこ〓ろわがもすゑまつやまなみこなみお君を置きて。あだし心を。我持たばヤ。ナヨヤ。末の松山。波も越えなむヤ。波もこえなむ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 7,
   "poems": []
  },
  {
   "id": "fuzoku-000008",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "越方",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "遠方や。彼方や。安達の原にた〓るからに。た〓るからに。うわるからに。おのをによする。さ寢としなくに。よせばよせ。よせばよせ。よそふる人の。憎からなくに。り、し意の強辭なるべをはよと同",
   "yomi": "",
   "sachu": "宵りを-宵よ",
   "jo": false,
   "pages": [
    89
   ],
   "no": 8,
   "poems": []
  },
  {
   "id": "fuzoku-000009",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "小車",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "小車。綿の紐とかむ。宵りをしのばせヨヤナ。われしのばせこ。われしのばせ。そよまさに。ねてけらしも。月の面を。さわたる雲の。まさやけく。みるこ。さやけくみる。づ此歌古今集に出に心なくもさやにも見しが見たしと思ふの此歌同上ゆ此歌古今集に見",
   "yomi": "",
   "sachu": "云々-明らかに",
   "jo": false,
   "pages": [
    89
   ],
   "no": 9,
   "poems": []
  },
  {
   "id": "fuzoku-000010",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "奧陸",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "アハレヤ。阿武隈に。霧立ちわたり。明けぬとも。夫をばやらじ。待てばすべなしャ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 10,
   "poems": []
  },
  {
   "id": "fuzoku-000011",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "斐甲",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "甲斐が嶺を。さやにも見しがャ。け〓れなく。心なく。橫ほり立てる。さやの中山。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 11,
   "poems": []
  },
  {
   "id": "fuzoku-000012",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "常陸",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "筑波嶺の。このもかのもに。陰はあれどヤ。君がみかげに。ます陰も。ますかげもなしヤ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 12,
   "poems": []
  },
  {
   "id": "fuzoku-000013",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "同",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "常陸にも。ひたち。田をこそ作れ。たつくあだ心や。兼ぬとや君が。山を越え。野を越え。雨夜きませる。",
   "yomi": "",
   "sachu": "大鳥-鶴",
   "jo": false,
   "pages": [
    89,
    90
   ],
   "no": 13,
   "poems": []
  },
  {
   "id": "fuzoku-000014",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "筑波山",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "筑波山。つくばやま葉山しげ山。やましげきをぞや。たが子も通ふな。下にかよへ。我つまは下に。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 14,
   "poems": []
  },
  {
   "id": "fuzoku-000015",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "月面",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "月のおもを。さわたる雲の。まさやけくみる。なはの。圓江の。秋なれば。霧立ちわたる。なはのつぶら江。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 15,
   "poems": []
  },
  {
   "id": "fuzoku-000016",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "大鳥",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "大鳥の。羽根に。はヤレナ。霜降れり。ヤレナ。誰かさ云ふ。千鳥ぞさいふ。〓ぞさいふ蒼鷺ぞ。京より來て。さ云ふ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 16,
   "poems": []
  },
  {
   "id": "fuzoku-000017",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "奈末不利",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "なはのつぶら江の。春なれば。霞みて見ゆる。なはのつぶら江。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 17,
   "poems": []
  },
  {
   "id": "fuzoku-000018",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "荒田",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "あらたに生ふる。富草の花。手に摘み入て。宮へ參らむ。なかつたえ。今井似閑は橫大路に酒を買ひの意とす",
   "yomi": "",
   "sachu": "よこほち云々-",
   "jo": false,
   "pages": [
    90
   ],
   "no": 18,
   "poems": []
  },
  {
   "id": "fuzoku-000019",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "東路",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "あづまぢに。かるかやの。よこほちになさけを。かいかるかやの。見ねばや。こともやすらに。かるかやの。しさや。かいかるかやの。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 19,
   "poems": []
  },
  {
   "id": "fuzoku-000020",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "菅牟良",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "すがむらの。ヤハレ。小菅叢のヤ。むらのャ。生ひては我こそ。かい刈らめ。は父母とすうそふいー嘯きしだらーしだる",
   "yomi": "",
   "sachu": "ち〓ら〓-眞淵なるべしてうと-調度也、弓矢の類に同じ、垂也",
   "jo": false,
   "pages": [
    90
   ],
   "no": 20,
   "poems": []
  },
  {
   "id": "fuzoku-000021",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "知々良々",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "ち〓ら〓が門に。うそふい。まろこそ立てれ。てうとをひさげて。などかはや立てりしもせざらむ。おのれかや。最愛者の門に。てうとをひさげて。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 21,
   "poems": []
  },
  {
   "id": "fuzoku-000022",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "門我",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "わが門のや。しだら小柳。サハレ。トウ〓〓しだる小柳。しだるカイテハ。ナヨヤ。しだる小柳。しだるカイテハヤ。國ぞ富せむ。郡ぞ榮えむ。里ぞ富せむ。吾家ぞ富せむヤ。しだるこやなぎ。",
   "yomi": "",
   "sachu": "此歌前の鴛鴦と監督に",
   "jo": false,
   "pages": [
    90,
    91
   ],
   "no": 22,
   "poems": []
  },
  {
   "id": "fuzoku-000023",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "乎之高倍",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "をしたかべ。鴨さへ來ゐる。原の池に。生ふる玉藻はャ。よき草の。ゆかりぞヤ。まねな刈りそヤ。",
   "yomi": "",
   "sachu": "あやしきものをャー奇しき事をなすよの意なとてへば-何と云へば也",
   "jo": false,
   "pages": [
    91
   ],
   "no": 23,
   "poems": []
  },
  {
   "id": "fuzoku-000024",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "伊勢人",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "伊勢人は。あやしきものをャ。なとてへば。小舟に乘りてャ。波の上を漕ぐヤ。波のへをこぐャ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    91
   ],
   "no": 24,
   "poems": []
  },
  {
   "id": "fuzoku-000025",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "加比加禰",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "甲斐が嶺に。白きは雪かャ。否をさの。かひの褻衣や。ならす調布や。さらすてふくり中。とて制する也あなかまーあ〓ソ)か鳴高一夜鳴高しヤ。鳴高し。大宮近くて。なりたかし。アハレノ。なりたかし。",
   "yomi": "",
   "sachu": "鳴高し-音高し喧し、制止の詞あそか-密(ミ八少女-あまたの少女",
   "jo": false,
   "pages": [
    91
   ],
   "no": 25,
   "poems": []
  },
  {
   "id": "fuzoku-000026",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "二段",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "音なせそや。音なせそ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    91
   ],
   "no": 26,
   "poems": []
  },
  {
   "id": "fuzoku-000027",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "三段",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "あなかま。こむともヤ。あそかなれ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    91
   ],
   "no": 27,
   "poems": []
  },
  {
   "id": "fuzoku-000028",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "八乎止女",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "八少女は。わが八少女ぞ。をとめ立つや八少女。立つや八少女。神の坐す。高天の原に。立つや少女。立つや八少女。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    91
   ],
   "no": 28,
   "poems": []
  },
  {
   "id": "fuzoku-000029",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "彼乃行",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "かの行くは。雁か鵠か雁ならば。ハレヤ。トウ〓〓",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    91
   ],
   "no": 29,
   "poems": []
  }
 ],
