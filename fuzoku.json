 "blocks": [
  {
   "id": "fuzoku-000003",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "小筑波",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "小筑波を。こゆるすりきぬ。かへりきてャ。たが戀すくせ。をつくばを。こゆるすきぬ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    88
   ],
   "no": 3,
   "poems": [],
   "notes": [
    {
     "a": "こゆるすりきぬ。かへり",
     "n": "こゆるすりきぬ―眞淵云、こゆすぐりきぬの誤也、此所より過來ぬと也",
     "k": "頭注"
    },
    {
     "a": "たが戀すくせ",
     "n": "戀すくせ―戀のやりすごしにくき也",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000004",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "小由流支",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "小淘綾の。磯立ち馴らし。磯ならし。菜摘む。童女ぬらすな。ぬらすな沖に折れ。をれ波ヤ。濡ろ〳〵も。君が食すべき。めすべき。菜をし摘み。摘みて。ハヤ。",
   "yomi": "",
   "jo": false,
   "pages": [
    88
   ],
   "no": 4,
   "poems": [],
   "notes": [
    {
     "a": "菜摘む",
     "n": "此歌古今集東歌に見え「菜摘む」を「磯菜摘む」に作る",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000005",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "玉埀",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "玉だれの。小瓶を。中にすゑて。主はもや。肴覓ぎに。肴とりに。こゆるぎの。磯の若和布。刈りあげに。鴛鴦鴛鷸。鴨さへ來ゐる。原の池のャ。玉藻はまねな刈りそャ。生ひも續ぐがにや。おひもつぐがに。",
   "yomi": "",
   "jo": false,
   "pages": [
    88,
    89
   ],
   "no": 5,
   "poems": [],
   "notes": [
    {
     "a": "鴨さへ",
     "n": "和名抄「多加閉、貌似鴨而小背上有文」",
     "k": "頭注"
    },
    {
     "a": "玉藻はまね",
     "n": "まね―眞に也",
     "k": "頭注"
    },
    {
     "a": "鴛鴦鴛鷸",
     "n": "此歌古今集に見ゆ",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000006",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "之太乃浦",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "しだの浦を。朝こぐ小舟。さし寄せろ。我さへ乘りてナ。しだよ。しだの浦みむヤ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 6,
   "poems": [],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000007",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "君乎置天",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "君を置きて。あだし心を。我持たばヤ。ナヨヤ。末の松山。波も越えなむヤ。波もこえなむ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 7,
   "poems": [],
   "notes": [
    {
     "a": "君を置きて",
     "n": "此歌古今集に見ゆ",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000008",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "越方",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "遠方や。彼方や。安達の原にたゝるからに。たゝるからに。うわるからに。おのをによする。さ寢としなくに。よせばよせ。よせばよせ。よそふる人の。憎からなくに。",
   "yomi": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 8,
   "poems": [],
   "notes": [
    {
     "a": "おのをによする",
     "n": "おのをによする―己を似寄する、己をそれに比する意なるべし",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000009",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "小車",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "小車。錦の紐とかむ。宵りをしのばせヨヤナ。われしのばせこ。われしのばせ。そよまさに。ねてけらしも。月の面を。さわたる雲の。まさやけく。みるこ。さやけくみる。",
   "yomi": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 9,
   "poems": [],
   "notes": [
    {
     "a": "宵りをしのばせ",
     "n": "宵りを―宵よりをはよと同意の強辭なるべし",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000010",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "陸奧",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "アハレヤ。阿武隈に。霧立ちわたり。明けぬとも。夫をばやらじ。待てばすべなしャ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 10,
   "poems": [],
   "notes": [
    {
     "a": "阿武隈に",
     "n": "此歌古今集に見ゆ",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000011",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "甲斐",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "甲斐が嶺を。さやにも見しがャ。けゝれなく。心なく。橫ほり立てる。さやの中山。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 11,
   "poems": [],
   "notes": [
    {
     "a": "さやにも見しが",
     "n": "此歌同上。さやにも見しが云々―明らかに見たしと思ふのに心なくも",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000012",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "常陸",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "筑波嶺の。このもかのもに。陰はあれどヤ。君がみかげに。ます陰も。ますかげもなしヤ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    89
   ],
   "no": 12,
   "poems": [],
   "notes": [
    {
     "a": "筑波嶺の",
     "n": "此歌古今集に出づ",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000013",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "同",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "常陸にも。田をこそ作れ。あだ心や。兼ぬとや君が。山を越え。野を越え。雨夜きませる。",
   "yomi": "",
   "jo": false,
   "pages": [
    89,
    90
   ],
   "no": 13,
   "poems": [],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000014",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "筑波山",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "筑波山。葉山しげ山。しげきをぞや。たが子も通ふな。下にかよへ。我つまは下に。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 14,
   "poems": [],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000015",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "月面",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "月のおもを。さわたる雲の。まさやけくみる。なはの。圓江の。秋なれば。霧立ちわたる。なはのつぶら江。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 15,
   "poems": [],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000016",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "大鳥",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "大鳥の。羽根に。ヤレナ。霜降れり。ヤレナ。誰かさ云ふ。千鳥ぞさいふ。〓ぞさいふ。蒼鷺ぞ。京より來て。さ云ふ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 16,
   "poems": [],
   "notes": [
    {
     "a": "大鳥の",
     "n": "大鳥―鶴",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000017",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "奈末不利",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "なはのつぶら江の。春なれば。霞みて見ゆる。なはのつぶら江。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 17,
   "poems": [],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000018",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "荒田",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "あらたに生ふる。富草の花。手に摘み入て。宮へ參らむ。なかつたえ。",
   "yomi": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 18,
   "poems": [],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000019",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "東路",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "あづまぢに。かるかやの。よこほちになさけを。かいかるかやの。見ねばや。こともやすらに。かるかやの。しさや。かいかるかやの。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 19,
   "poems": [],
   "notes": [
    {
     "a": "よこほちになさけを",
     "n": "よこほち云々―今井似閑は橫大路に酒を買ひの意とす",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000020",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "菅牟良",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "すがむらの。ヤハレ。小菅叢のヤ。むらのヤ。生ひては我こそ。かい刈らめ。",
   "yomi": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 20,
   "poems": [],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000021",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "知々良々",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "ちゝらゝが門に。うそふい。まろこそ立てれ。てうとをひさげて。などかはや立てりしもせざらむ。おのれかや。最愛者の門に。てうとをひさげて。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    90
   ],
   "no": 21,
   "poems": [],
   "notes": [
    {
     "a": "ちゝらゝが門に",
     "n": "ちゝらゝ―眞淵は父母とす",
     "k": "頭注"
    },
    {
     "a": "うそふい",
     "n": "うそふい―嘯きなるべし",
     "k": "頭注"
    },
    {
     "a": "てうとをひさげて。などか",
     "n": "てうと―調度也、弓矢の類",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000022",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "我門",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "わが門のや。しだら小柳。サハレ。トウ〳〵しだる小柳。しだるカイテハ。ナヨヤ。しだる小柳。しだるカイテハヤ。國ぞ富せむ。郡ぞ榮えむ。里ぞ富せむ。吾家ぞ富せむヤ。しだるこやなぎ。",
   "yomi": "",
   "jo": false,
   "pages": [
    90,
    91
   ],
   "no": 22,
   "poems": [],
   "notes": [
    {
     "a": "しだら小柳",
     "n": "しだら―しだるに同じ、垂也",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000023",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "乎之高倍",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "をしたかべ。鴨さへ來ゐる。原の池に。生ふる玉藻はャ。よき草の。ゆかりぞヤ。まねな刈りそヤ。",
   "yomi": "",
   "jo": false,
   "pages": [
    91
   ],
   "no": 23,
   "poems": [],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000024",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "伊勢人",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "伊勢人は。あやしきものをャ。なとてへば。小舟に乘りてャ。波の上を漕ぐヤ。波のへをこぐャ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    91
   ],
   "no": 24,
   "poems": [],
   "notes": [
    {
     "a": "あやしきものをャ",
     "n": "あやしきものをヤ―奇しき事をなすよの意",
     "k": "頭注"
    },
    {
     "a": "なとてへば",
     "n": "なとてへば何と云へば也",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000025",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "加比加禰",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "甲斐が嶺に。白きは雪かャ。否をさの。かひの褻衣や。ならす調布や。さらすてふくりヤ。鳴高しヤ。鳴高し。大宮近くて。なりたかし。アハレノ。なりたかし。",
   "yomi": "",
   "jo": false,
   "pages": [
    91
   ],
   "no": 25,
   "poems": [],
   "notes": [
    {
     "a": "鳴高しヤ",
     "n": "鳴高し―音高しとて制する也",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000026",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "二段",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "音なせそや。音なせそ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    91
   ],
   "no": 26,
   "poems": [],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000027",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "三段",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "あなかま。こむともヤ。あそかなれ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    91
   ],
   "no": 27,
   "poems": [],
   "notes": [
    {
     "a": "あなかま",
     "n": "あなかま―あゝ喧し、制止の詞",
     "k": "頭注"
    },
    {
     "a": "あそかなれ",
     "n": "あそかなれ―密（ミソ）か",
     "k": "頭注"
    }
   ],
   "pid": "1913603"
  },
  {
   "id": "fuzoku-000028",
   "form": "uta",
   "maki": "",
   "bu": "",
   "dai": "八乎止女",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "八少女は。わが八少女ぞ。立つや八少女。立つや八少女。神の坐す。高天の原に。立つや少女。立つや八少女。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
    91
   ],
   "no": 28,
   "poems": [],
   "notes": [
    {
     "a": "八少女は",
     "n": "八少女―あまたの少女",
     "k": "頭注"
